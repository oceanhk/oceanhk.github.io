---
interface Props {
  title: string;
  description: string;
  episode: string;
  href: string;
}

const { title, description, episode, href } = Astro.props;
---

<a class="video-card" href={href}>
  <div class="video-thumbnail">
    {episode}
  </div>

  <div class="video-info">
    <h3>{title}</h3>

    <p>{description}</p>

    <span class="video-link"> 閱讀更多 → </span>
  </div>
</a>
