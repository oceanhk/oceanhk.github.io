---
import { getCollection, render } from "astro:content";
import VideoLayout from "../../layouts/VideoLayout.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";

export async function getStaticPaths() {
  const episodes = await getCollection("survival");

  return episodes
    .filter((episode) => !episode.data.draft)
    .map((episode) => ({
      params: {
        slug: episode.id,
      },
      props: {
        episode,
      },
    }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
---

<VideoLayout
  title={`EP${String(episode.data.episode).padStart(2, "0")}｜${episode.data.title}`}
>
  <section class="section">
    <h1>
      EP{String(episode.data.episode).padStart(2, "0")}｜{episode.data.title}
    </h1>

    <p>{episode.data.description}</p>
  </section>

  <section class="section">
    <h2>🎬 YouTube</h2>

    <YouTubeEmbed videoId={episode.data.youtube} title={episode.data.title} />
  </section>

  <section class="section">
    <Content />
  </section>
</VideoLayout>
