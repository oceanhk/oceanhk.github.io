---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import VideoCard from "../../components/VideoCard.astro";

const episodes = await getCollection("survival");

// 依集數排序
episodes.sort((a, b) => a.data.episode - b.data.episode);
---

<BaseLayout title="生存世界系列 | 海洋 Minecraft Resources">
  <PageHero
    title="🏠 生存世界系列"
    description="同一個 Minecraft 世界，記錄每一次建造、冒險、生電與建築。"
  />

  <section class="section">
    <h2>系列介紹</h2>

    <p>
      這是一個長期經營的 Minecraft 生存世界。
      每一集都會在同一個世界中建造、探索與發展，
      並分享世界中的建築、機器與創作。
    </p>
  </section>

  <section class="section">
    <h2>世界設定</h2>

    <ul>
      <li>Minecraft 版本：1.21</li>
      <li>遊戲模式：生存模式</li>
      <li>難度：困難</li>
    </ul>
  </section>

  <section class="section">
    <h2>使用資源</h2>

    <ul>
      <li>模組：待更新</li>
      <li>資源包：待更新</li>
      <li>光影：待更新</li>
    </ul>
  </section>

  <section class="section">
    <h2>所有影片</h2>

    <div class="video-grid">
      {
        episodes.map((episode) => (
          <VideoCard
            episode={String(episode.data.episode).padStart(2, "0")}
            title={episode.data.title}
            description={episode.data.description}
            href={`/survival/${episode.id}/`}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
